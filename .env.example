DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grace_high_school
# Production: any standard Postgres URL works (Coolify Postgres, Neon, Supabase, etc.)
# Coolify: link your Postgres service and set DATABASE_URL in the app environment.
# First-boot only (creates admin if none exist). Passwords set in /dashboard/
# are kept across deploys. To force-reset from env once, also set:
# ADMIN_SYNC_PASSWORD=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GraceAdmin123
# ADMIN_SYNC_PASSWORD=
# Object storage: leave PRIVATE_OBJECT_DIR unset to store uploads in Postgres
# (survives Render restarts). Optional disk cache: LOCAL_UPLOAD_DIR=.local/uploads
# On Replit/GCS, set:
# PRIVATE_OBJECT_DIR=/replit-objstore-.../private
# PUBLIC_OBJECT_SEARCH_PATHS=/replit-objstore-.../public
SESSION_SECRET=local-dev-session-secret
PASSWORD_RESET_SECRET=change-me-recovery-code
NODE_ENV=development
# API server port (used when API_PROXY_TARGET points at local api-server)
PORT=8080
# Where local `pnpm dev:admin` sends /api (and SSE /api/events).
# For fully local work against `pnpm dev:api`, set:
# API_PROXY_TARGET=http://localhost:8080
API_PROXY_TARGET=http://localhost:8080
#
# --- Coolify full-stack (Dockerfile) — set in the Coolify app environment ---
# NODE_ENV=production
# PORT=8080                    # Coolify injects this automatically
# DATABASE_URL=postgresql://…  # required — link Coolify Postgres
# SESSION_SECRET=…             # required — long random string (sessions survive redeploys)
# ALLOWED_ORIGINS=https://gracehighschoolgayaza.academy,https://www.gracehighschoolgayaza.academy
# Health check path in Coolify: /healthz (or /api/healthz)
# PGSSL=true                   # only if your Postgres provider requires TLS
#
# Frontends use same-origin /api (VITE_API_BASE_URL is intentionally unset in .env.production).
# Optional: PASSWORD_RESET_SECRET, LOG_LEVEL=debug
